<Window x:Class="SkladWPF.MaterialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Материалы" Height="560" Width="980" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Справочник материалов" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="txtSearch" Width="220" Padding="3"/>
            <Button Content="Найти"     Click="Search_Click"  Margin="5,0,0,0" Padding="12,3"/>
            <Button Content="Обновить"  Click="Refresh_Click" Margin="5,0,0,0" Padding="12,3"/>
            <Button x:Name="btnAdd" Content="Добавить" Click="Add_Click" Margin="20,0,0,0" Padding="12,3"/>
            <Button x:Name="btnEdit" Content="Изменить" Click="Edit_Click" Margin="5,0,0,0" Padding="12,3"/>
            <Button x:Name="btnDelete" Content="Удалить" Click="Delete_Click" Margin="5,0,0,0" Padding="12,3"/>
        </StackPanel>

        <DataGrid x:Name="dgMaterials" Grid.Row="2" AutoGenerateColumns="True"
                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"/>

        <TextBlock x:Name="txtStatus" Grid.Row="3" Margin="0,5,0,0" Foreground="Gray"/>
        
    </Grid>
</Window>