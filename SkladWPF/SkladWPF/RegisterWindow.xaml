<Window x:Class="SkladWPF.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" Height="580" Width="450" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtTitle" Grid.Row="0" Text="Регистрация" FontSize="18" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- Основная форма -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Логин:" Margin="0,5,0,0"/>
                <TextBox x:Name="txtLogin" Padding="3"/>

                <TextBlock Text="Пароль:" Margin="0,5,0,0"/>
                <PasswordBox x:Name="txtPassword" Padding="3"/>

                <!-- Блок для Клиента -->
                <StackPanel x:Name="pnlKlient">
                    <TextBlock Text="Название компании:" Margin="0,10,0,0"/>
                    <TextBox x:Name="txtCompany" Padding="3"/>

                    <TextBlock Text="Адрес:" Margin="0,5,0,0"/>
                    <TextBox x:Name="txtAddress" Padding="3"/>

                    <TextBlock Text="Телефон:" Margin="0,5,0,0"/>
                    <TextBox x:Name="txtPhone" Padding="3"/>

                    <TextBlock Text="Фамилия директора:" Margin="0,5,0,0"/>
                    <TextBox x:Name="txtFam" Padding="3"/>

                    <TextBlock Text="Имя директора:" Margin="0,5,0,0"/>
                    <TextBox x:Name="txtImya" Padding="3"/>
                </StackPanel>

                <!-- Блок для Сотрудника (Staff) -->
                <StackPanel x:Name="pnlStaff" Visibility="Collapsed">
                    <TextBlock Text="Фамилия:" Margin="0,10,0,0"/>
                    <TextBox x:Name="txtStaffFam" Padding="3"/>

                    <TextBlock Text="Имя:" Margin="0,5,0,0"/>
                    <TextBox x:Name="txtStaffImya" Padding="3"/>

                    <TextBlock Text="Отчество:" Margin="0,5,0,0"/>
                    <TextBox x:Name="txtStaffOtch" Padding="3"/>

                    <TextBlock Text="Телефон:" Margin="0,5,0,0"/>
                    <TextBox x:Name="txtStaffPhone" Padding="3"/>
                </StackPanel>

                <!-- Выбор роли (только для Админа, если нужно) -->
                <StackPanel x:Name="pnlRole" Visibility="Collapsed">
                    <TextBlock Text="Роль:" Margin="0,10,0,0"/>
                    <ComboBox x:Name="cmbRole" Padding="3">
                        <ComboBoxItem Content="Кладовщик"/>
                        <ComboBoxItem Content="Менеджер"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Зарегистрировать" Click="Save_Click" Width="140" Padding="5" Margin="0,0,10,0" Background="LightGreen"/>
            <Button Content="Отмена" Click="Cancel_Click" Width="100" Padding="5"/>
        </StackPanel>
    </Grid>
</Window>