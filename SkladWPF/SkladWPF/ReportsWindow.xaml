<Window x:Class="SkladWPF.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SkladWPF"
        Title="Отчет по остаткам" Height="600" Width="1050" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Конвертер для определения цвета ячейки -->
        <local:StockColorConverter x:Key="StockColorConverter"/>

        <!-- Стиль для текста строки (делаем его полужирным) -->
        <Style TargetType="DataGridCell">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Остатки материалов на складе" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Обновить" Click="Refresh_Click" Padding="12,3" FontWeight="Bold"/>
        </StackPanel>

        <!-- Возвращаем стандартную виртуализацию (она работает лучше) -->
        <DataGrid x:Name="dg" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  RowHeight="30" GridLinesVisibility="All" HeadersVisibility="Column"
                  LoadingRow="dg_LoadingRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="50"/>
                <DataGridTextColumn Header="Материал" Binding="{Binding Материал}" Width="*"/>
                <DataGridTextColumn Header="ЕдИзм" Binding="{Binding ЕдИзм}" Width="70"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Цена}" Width="80"/>
                <DataGridTextColumn Header="Приход" Binding="{Binding Приход}" Width="80"/>
                <DataGridTextColumn Header="Расход" Binding="{Binding Расход}" Width="80"/>

                <!-- Столбец Остаток с привязкой цвета фона -->
                <DataGridTextColumn Header="Остаток" Binding="{Binding Остаток}" Width="90">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource StockColorConverter}">
                                        <Binding Path="Приход"/>
                                        <Binding Path="Остаток"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Сумма остатка" Binding="{Binding СуммаОстатка}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>