<Window x:Class="SkladWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Склад стройматериалов" Height="520" Width="720"
        WindowStartupLocation="CenterScreen" MinHeight="300" MinWidth="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15">
            <TextBlock x:Name="txtHeader" Text="Информационно-справочная система" Foreground="White" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" HorizontalAlignment="Center"/>
        </Border>

        <!-- Информация о пользователе -->
        <TextBlock x:Name="txtUserInfo" Grid.Row="1" HorizontalAlignment="Right" Margin="10,5,10,0" Foreground="Gray"/>

        <!-- Основное меню -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">
                <!-- Справочники -->
                <Button x:Name="btnMaterials"      Content="Материалы"            Click="OpenMaterials_Click"     Height="42" Margin="0,4" FontSize="14"/>
                <Button x:Name="btnProizvoditels"  Content="Производители"         Click="OpenProizvoditels_Click" Height="42" Margin="0,4" FontSize="14"/>
                <Button x:Name="btnCounterparties" Content="Контрагенты"           Click="OpenCounterparties_Click" Height="42" Margin="0,4" FontSize="14"/>

                <!-- Документы -->
                <Button x:Name="btnNakladnayas"    Content="Накладные"             Click="OpenNakladnayas_Click"   Height="42" Margin="0,4" FontSize="14"/>

                <!-- Отчеты -->
                <Button x:Name="btnReports"        Content="Отчет по остаткам"     Click="OpenReports_Click"       Height="42" Margin="0,4" FontSize="14"/>

                <!-- Админ -->
                <Button x:Name="btnRegisterStaff" Content="Пользователи" Click="OpenUsers_Click" Height="42" Margin="0,15,0,0" FontSize="14" Background="LightBlue"/>

                <Button Content="Выход"            Click="Exit_Click"               Height="42" Margin="0,15,0,0" FontSize="14"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>