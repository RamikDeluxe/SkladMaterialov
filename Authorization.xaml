<Window x:Class="SkladWPF.Authorization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SkladWPF"
        mc:Ignorable="d"
        Title="Authorization" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" Padding="15">
            <TextBlock Text="Информационно-справочная система Склад стройматериалов"
                       Foreground="White" FontSize="16" FontWeight="Bold"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>
        </Border>


        <StackPanel Margin="20" Grid.Row="1">
            <TextBox Width="350" Height="50" FontSize="18" Margin="15"/>
            <PasswordBox Width="350" Height="50" FontSize="18"/>
            <Button Content="Войти" Click="Login_Click" Height="42" FontSize="18" Width="350" HorizontalAlignment="Center" Margin="15"/>
            <Button Content="Выход" Click="Exit_Click" Height="42" FontSize="18" Width="200" HorizontalAlignment="Left" Margin="0,100"/>
        </StackPanel>

    </Grid>
</Window>
