<Window x:Class="SkladWPF.NakladnayasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Накладные" Height="600" Width="1200" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Обновить" Click="Refresh_Click" Padding="12,3"/>
        </StackPanel>

        <!-- Основная область -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: ПРИХОД -->
            <Grid Grid.Column="0" x:Name="gridIncoming">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="ПРИХОД" FontSize="16" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,5"/>

                <DataGrid x:Name="dgIncoming" Grid.Row="1" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Номер" Binding="{Binding Номер}" Width="60"/>
                        <DataGridTextColumn Header="Дата" Binding="{Binding Дата, StringFormat=dd.MM.yyyy}" Width="80"/>
                        <DataGridTextColumn Header="Поставщик" Binding="{Binding Поставщик}" Width="*"/>
                        <DataGridTextColumn Header="Телефон" Binding="{Binding Телефон}" Width="120"/>
                        <!-- Выделенный столбец Цены/Суммы -->
                        <DataGridTextColumn Header="Сумма" Binding="{Binding Сумма}" Width="90" FontWeight="Bold">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Background" Value="#FFF9E6"/>
                                    <!-- Светло-желтый фон -->
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#D35400"/>
                                    <!-- Оранжевый текст -->
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Button Grid.Row="2" Content="Сформировать PDF (Приход)" 
                        Click="ShowIncomingItems_Click" Margin="0,10,0,0" Padding="5"/>
            </Grid>

            <!-- Правая колонка: РАСХОД -->
            <Grid Grid.Column="2" x:Name="gridOutgoing">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="РАСХОД" FontSize="16" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,5"/>

                <DataGrid x:Name="dgOutgoing" Grid.Row="1" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Номер" Binding="{Binding Номер}" Width="60"/>
                        <DataGridTextColumn Header="Дата" Binding="{Binding Дата, StringFormat=dd.MM.yyyy}" Width="80"/>
                        <DataGridTextColumn Header="Клиент" Binding="{Binding Клиент}" Width="*"/>
                        <DataGridTextColumn Header="Телефон" Binding="{Binding Телефон}" Width="120"/>
                        <!-- Выделенный столбец Цены/Суммы -->
                        <DataGridTextColumn Header="Сумма" Binding="{Binding Сумма}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Background" Value="#FFF9E6"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#D35400"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Button Grid.Row="2" Content="Сформировать PDF (Расход)" 
                        Click="ShowOutgoingItems_Click" Margin="0,10,0,0" Padding="5"/>
            </Grid>
        </Grid>
    </Grid>
</Window>